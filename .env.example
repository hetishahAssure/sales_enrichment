# Copy this file to .env and fill in your real keys.
#   cp .env.example .env
#
# ANTHROPIC_API_KEY is required (Source 1 — Claude web search).
# The others are optional — leave blank to skip that source.

# Source 1 — Claude AI + Web Search (required)
ANTHROPIC_API_KEY=

# Source 2 — JSearch via RapidAPI (optional)
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
JSEARCH_API_KEY=

# Source 3 — Theirstack (optional)
# https://theirstack.com
THEIRSTACK_API_KEY=

# Source 4 — Apollo.io (optional)
# https://developer.apollo.io
APOLLO_API_KEY=
