# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Prospect / customer data (keep sample templates only)
data/*.csv
!data/samples/
!data/samples/**

# Legacy root data paths (in case files are recreated at root)
YPO_*.csv
!YPO_*.sample.csv
*.out.csv

# Personal / scratch files
*.docx
Untitled-*.py

# Windows mark-of-the-web metadata (from files downloaded/copied on Windows)
*:Zone.Identifier

# OS / editor
.DS_Store
.idea/
.vscode/
